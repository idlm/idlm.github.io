.hero-quote {
  margin-top: 12px;
  padding: 0 16px;
  text-align: center;
  line-height: 1.5;
}
.hero-quote .hero-quote-zh {
  font-size: 1.05rem;
  font-weight: 500;
  color: #555;
  margin: 0 0 4px 0;
  letter-spacing: 0.5px;
}
.hero-quote .hero-quote-en {
  font-size: 0.82rem;
  font-style: italic;
  color: #888;
  margin: 0;
  letter-spacing: 0.3px;
}
@media (prefers-color-scheme: dark) {
  .hero-quote .hero-quote-zh { color: #c8c8c8; }
  .hero-quote .hero-quote-en { color: #8a8a8a; }
}
