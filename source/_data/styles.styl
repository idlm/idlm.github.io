/* ===== AI 工作台 (首页) ===== */

.ai-workbench {
  max-width: 880px;
  margin: 28px auto 36px;
  padding: 0 16px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* —— 三个入口网格 —— */
.workbench-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}
.wb-card {
  display: block;
  text-decoration: none;
  padding: 18px 16px;
  border-radius: 12px;
  text-align: center;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  background: rgba(255, 255, 255, 0.55);
  border: 1px solid rgba(127, 127, 127, 0.18);
  color: inherit;
  backdrop-filter: blur(6px);
}
.wb-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  border-color: rgba(0, 200, 180, 0.45);
}
.wb-icon { font-size: 32px; line-height: 1; margin-bottom: 8px; }
.wb-title { font-size: 1rem; font-weight: 600; margin-bottom: 4px; }
.wb-desc { font-size: 0.78rem; color: #777; }

/* —— Chat 搜索框 —— */
.ai-search { margin: 0 auto; max-width: 720px; }
.ai-search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 6px 6px 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(127, 127, 127, 0.22);
  transition: border-color 0.18s ease, box-shadow 0.18s ease;
  backdrop-filter: blur(6px);
}
.ai-search-box:focus-within {
  border-color: rgba(0, 200, 180, 0.7);
  box-shadow: 0 0 0 3px rgba(0, 200, 180, 0.12);
}
.ai-search-icon { font-size: 1.1rem; }
.ai-search-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 0.95rem;
  padding: 10px 4px;
  color: inherit;
}
.ai-search-input::placeholder { color: #999; }
.ai-search-btn {
  border: none;
  cursor: pointer;
  padding: 8px 18px;
  border-radius: 999px;
  background: linear-gradient(135deg, #00c8b4, #0090ff);
  color: #fff;
  font-size: 0.88rem;
  font-weight: 500;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.ai-search-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(0, 200, 180, 0.35);
}
.ai-search-hint {
  text-align: center;
  margin-top: 10px;
  font-size: 0.74rem;
  color: #999;
}

/* —— 深色模式 —— */
@media (prefers-color-scheme: dark) {
  .wb-card {
    background: rgba(30, 30, 35, 0.55);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .wb-desc { color: #999; }
  .ai-search-box {
    background: rgba(30, 30, 35, 0.65);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .ai-search-box:focus-within {
    border-color: rgba(0, 200, 180, 0.6);
    box-shadow: 0 0 0 3px rgba(0, 200, 180, 0.18);
  }
  .ai-search-input::placeholder { color: #666; }
  .ai-search-hint { color: #666; }
}

/* —— 手机适配 —— */
@media (max-width: 640px) {
  .workbench-grid {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .ai-search-box { padding: 4px 4px 4px 12px; }
  .ai-search-btn { padding: 7px 12px; font-size: 0.82rem; }
  .ai-search-hint { font-size: 0.7rem; padding: 0 4px; }
}
